# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Public URL of the app (used for CORS)
PUBLIC_URL=http://your-vps-ip-or-domain
HTTP_PORT=80
MAX_ACTIONS_PER_JOURNEY=8
JOURNEY_TIMEOUT_SECONDS=180
PARALLEL_JOURNEYS=4
