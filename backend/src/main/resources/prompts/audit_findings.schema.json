{
  "type": "object",
  "properties": {
    "summary": {"type": "string", "description": "2-4 sentence executive summary of the simulated journeys"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "description": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "personaName": {"type": "string"},
          "affectedUrl": {"type": "string"},
          "evidenceIds": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidenceSummary": {"type": "string", "description": "What the browser evidence shows"},
          "frictionReason": {"type": "string", "description": "Why this creates customer friction"},
          "recommendation": {"type": "string"}
        },
        "required": ["title", "description", "severity", "personaName", "evidenceIds", "evidenceSummary", "frictionReason", "recommendation"]
      }
    }
  },
  "required": ["summary", "findings"]
}
